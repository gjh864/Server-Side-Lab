<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gonjunhan.helloserver.mapper.UserInfoMapper">
    <update id="updateByUserId" parameterType="com.gonjunhan.helloserver.entity.UserInfo">
        UPDATE user_info
        SET real_name = #{realName},
            phone = #{phone},
            address = #{address}
        WHERE user_id = #{userId}
    </update>
</mapper>